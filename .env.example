# Copy to .env (gitignored) and fill in. Compose interpolates these.

# --- Postgres ---
POSTGRES_USER=netrunner
POSTGRES_PASSWORD=change-me-blackwall-dev
POSTGRES_DB=cyberdash

# --- GitHub OAuth app (create at https://github.com/settings/developers) ---
# The terminal logs in with the OAuth *device flow* (DECISIONS D-14), so:
#   - tick "Enable Device Flow" on the app — without it `login` fails with
#     device_flow_disabled
#   - the callback URL is unused (put anything, e.g. http://localhost:5173)
#   - only the client id is needed; there is no client secret in this flow
# No app yet? Run the offline fake GitHub instead:
#   docker compose -f docker-compose.yml -f compose.github-stub.yml up --build --watch
GITHUB_CLIENT_ID=
